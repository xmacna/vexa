# syntax=docker/dockerfile:1.7
# XMACNA overlay for issue #524. The pinned upstream image supplies the complete,
# multi-architecture Vexa v0.12 runtime. The source directories below are copied as
# atomic ownership units so a new module cannot be omitted from the release image.
FROM vexaai/vexa-lite:v0.12.22@sha256:de252fdc232f25803c339371be62ef1ba6b407d8f44913a16d0ae94da94178a4
ARG XMACNA_SOURCE_REVISION=b17094049ad81c26aa8b8791202caa2ad1084bcf

COPY core/meetings/modules/gmeet-capture/src/ /app/core/meetings/modules/gmeet-capture/src/
COPY core/meetings/services/bot/build-browser-utils.mjs /app/core/meetings/services/bot/build-browser-utils.mjs
COPY core/meetings/services/bot/src/ /app/core/meetings/services/bot/src/
COPY core/meetings/contracts/acts.v1/ /app/core/meetings/contracts/acts.v1/
COPY core/gateway/services/gateway/src/gateway/ /app/core/gateway/services/gateway/src/gateway/
COPY core/identity/services/admin-api/src/admin_api/ /app/core/identity/services/admin-api/src/admin_api/
COPY core/meetings/services/meeting-api/src/meeting_api/ /app/core/meetings/services/meeting-api/src/meeting_api/
COPY core/runtime/src/runtime_kernel/ /app/core/runtime/src/runtime_kernel/
COPY contracts.seal.json schema.seal.json /app/

RUN cd /app/core/meetings/modules/gmeet-capture \
 && /app/node_modules/.bin/tsc \
 && cd /app/core/meetings/services/bot \
 && /app/node_modules/.bin/tsc \
 && node build-browser-utils.mjs \
 && test -s /app/core/meetings/services/bot/dist/index.js \
 && test -s /app/core/meetings/services/bot/dist/browser-utils.global.js \
 && grep -q 'chat_send_v2' /app/core/meetings/services/bot/dist/index.js \
 && test -s /app/core/meetings/services/meeting-api/src/meeting_api/lifecycle/chat_commands.py \
 && grep -q 'bot_chat_commands' /app/schema.seal.json \
 && grep -q 'claimed-probe' /app/core/runtime/src/runtime_kernel/api.py \
 && grep -q 'attested-teardown' /app/core/runtime/src/runtime_kernel/api.py \
 && grep -q 'chat/{command_id}' /app/core/gateway/services/gateway/src/gateway/app.py \
 && python3 -m compileall -q \
      /app/core/gateway/services/gateway/src/gateway \
      /app/core/identity/services/admin-api/src/admin_api \
      /app/core/meetings/services/meeting-api/src/meeting_api \
      /app/core/runtime/src/runtime_kernel

LABEL org.opencontainers.image.source="https://github.com/xmacna/vexa" \
      org.opencontainers.image.revision="${XMACNA_SOURCE_REVISION}" \
      ai.xmacna.base.digest="sha256:de252fdc232f25803c339371be62ef1ba6b407d8f44913a16d0ae94da94178a4" \
      ai.xmacna.issue="524"
